    {
      "parameters": {
        "jsCode": "const userMessage = $('When chat message received').first().json.chatInput;\nconst products = $input.all().map(item => item.json);\n\n// Lọc bỏ các row rỗng/lỗi\nconst validProducts = products.filter(p => p && p.product_name);\n\nif (validProducts.length === 0) {\n  // Không có sản phẩm → trả về thông báo rõ ràng\n  return [{\n    json: {\n      chatInput: userMessage,\n      hasProducts: false,\n      productData: [],\n      summary: \"Hiện shop chưa có sản phẩm bạn cần tìm 😢\"\n    }\n  }];\n}\n\n// Có sản phẩm → format danh sách\nconst productList = validProducts.map((p, i) => {\n  const price = Number(p.price).toLocaleString('vi-VN');\n  const size  = p.size  ? ` | Size: ${p.size}`  : '';\n  const color = p.color ? ` | Màu: ${p.color}`  : '';\n  return `${i + 1}. ${p.product_name}${color}${size} - Giá: ${price}đ`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    chatInput: userMessage,\n    hasProducts: true,\n    productData: validProducts,\n    summary: productList\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        512
      ],
      "id": "a65b5c4a-aace-4d1b-b062-3f197d308f3c",
      "name": "Code in JavaScript"
