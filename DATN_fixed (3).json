    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $node[\"When chat message received\"].json.chatInput }}",
        "options": {
          "systemMessage": "Bạn là nhân viên đặt hàng của cửa hàng thời trang Tashop.\n\nNhiệm vụ: Thu thập đầy đủ thông tin đặt hàng từ khách.\n\nThông tin cần thiết (5 mục):\n1. Tên sản phẩm (vd: Áo hoodie, Quần jean, Áo thun...)\n2. Size (S / M / L / XL / XXL)\n3. Màu sắc\n4. Số điện thoại\n5. Địa chỉ giao hàng\n\nQuy tắc xử lý:\n- Đọc kỹ tin nhắn của khách, trích xuất thông tin có sẵn.\n- Nếu CHƯA đủ 5 mục → hỏi thêm thân thiện, ghi rõ còn thiếu gì.\n- Nếu ĐÃ ĐỦ cả 5 mục → PHẢI trả về ĐÚNG format sau (không thêm chữ nào trước hoặc sau):\n\nORDER_JSON:{\"tenSanPham\":\"...\",\"size\":\"...\",\"mau\":\"...\",\"soDienThoai\":\"...\",\"diaChiGiaoHang\":\"...\"}\n\nVí dụ 1 – Thiếu thông tin:\nKhách: Tôi muốn mua áo hoodie đen size M\n→ Bạn chọn Hoodie Đen Size M rồi nha 🎉 Mình cần thêm:\n- 📞 Số điện thoại của bạn?\n- 🏠 Địa chỉ giao hàng?\n\nVí dụ 2 – Đủ thông tin:\nKhách: 0901234567, giao 123 Nguyễn Huệ Q1 HCM\n→ ORDER_JSON:{\"tenSanPham\":\"Hoodie\",\"size\":\"M\",\"mau\":\"Đen\",\"soDienThoai\":\"0901234567\",\"diaChiGiaoHang\":\"123 Nguyễn Huệ Q1 HCM\"}\n\nLưu ý: Chỉ xuất ORDER_JSON khi đủ CẢ 5 thông tin. Không bao giờ bịa thông tin."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -816,
        1600
      ],
      "id": "86c19bd4-e952-454b-8ceb-64178fcc1788",
      "name": "AI Agent4"
    },
    {
      "parameters": {
        "options": {
          "maxTokens": 500
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        -816,
        1824
      ],
      "id": "d5ce066d-e759-4a0c-8871-8bb0701bdcd4",
      "name": "OpenRouter Chat Model6",
      "credentials": {
        "openRouterApi": {
          "id": "09lHojSTHXmNdaPQ",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// PARSE ORDER: Trích xuất đơn hàng từ output của AI Agent4\n// ============================================================\nconst agentOutput = $input.first().json.output || '';\n\n// Tìm block ORDER_JSON trong output\nconst match = agentOutput.match(/ORDER_JSON:(\\{[^}]+\\})/);\n\nif (match) {\n  try {\n    const orderData = JSON.parse(match[1]);\n    \n    // Thêm timestamp đặt hàng\n    const now = new Date();\n    const pad = n => String(n).padStart(2, '0');\n    orderData.thoiGian = `${pad(now.getDate())}/${pad(now.getMonth()+1)}/${now.getFullYear()} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;\n    orderData.trangThai = 'Mới đặt';\n    \n    // Tin nhắn xác nhận đơn hàng gửi về chat\n    const confirmMsg = `✅ Đặt hàng thành công! Cảm ơn bạn đã mua tại Tashop 🎉\\n\\n📋 THÔNG TIN ĐƠN HÀNG\\n━━━━━━━━━━━━━━━━━\\n📦 Sản phẩm: ${orderData.tenSanPham}\\n📐 Size: ${orderData.size}\\n🎨 Màu: ${orderData.mau}\\n📞 SĐT: ${orderData.soDienThoai}\\n🏠 Địa chỉ: ${orderData.diaChiGiaoHang}\\n⏰ Thời gian: ${orderData.thoiGian}\\n━━━━━━━━━━━━━━━━━\\n\\nShop sẽ liên hệ xác nhận trong vòng 30 phút. Bạn có thể theo dõi đơn qua SĐT đã cung cấp! 🚀`;\n    \n    return [{\n      json: {\n        ...($input.first().json),\n        orderData: orderData,\n        orderFound: true,\n        output: confirmMsg\n      }\n    }];\n  } catch(e) {\n    // JSON parse lỗi → không phải đơn hàng hoàn chỉnh\n    return [{\n      json: {\n        ...($input.first().json),\n        orderFound: false\n      }\n    }];\n  }\n} else {\n  // Chưa đủ thông tin → agent đang hỏi thêm\n  return [{\n    json: {\n      ...($input.first().json),\n      orderFound: false\n    }\n  }];\n}"
      },
