    {
      "parameters": {
        "jsCode": "const msg = $('When chat message received').first().json.chatInput.toLowerCase();\n\nconst keywordMap = [\n  { phrases: ['áo sơ mi', 'sơ mi', 'shirt'], keyword: 'sơ mi' },\n  { phrases: ['hoodie', 'áo hoodie', 'áo nỉ có mũ'], keyword: 'hoodie' },\n  { phrases: ['áo thun', 'thun', 'tshirt', 't-shirt', 'áo phông'], keyword: 'thun' },\n  { phrases: ['quần jean', 'quần jeans', 'jean', 'jeans', 'bò'], keyword: 'jean' },\n  { phrases: ['áo khoác', 'khoác', 'jacket', 'coat'], keyword: 'khoác' },\n  { phrases: ['quần short', 'short', 'quần ngắn', 'quần đùi'], keyword: 'short' },\n  { phrases: ['quần kaki', 'kaki', 'khaki'], keyword: 'kaki' },\n  { phrases: ['quần tây', 'tây', 'slacks'], keyword: 'tây' },\n  { phrases: ['váy', 'chân váy', 'skirt', 'đầm'], keyword: 'váy' },\n  { phrases: ['áo polo', 'polo'], keyword: 'polo' },\n  { phrases: ['áo len', 'len', 'sweater'], keyword: 'len' },\n  { phrases: ['blazer', 'vest'], keyword: 'blazer' },\n  { phrases: ['quần'], keyword: 'quần' },\n  { phrases: ['áo'], keyword: 'áo' },\n];\n\nlet keyword = '';\nfor (const { phrases, keyword: kw } of keywordMap) {\n  if (phrases.some(p => msg.includes(p))) {\n    keyword = kw;\n    break;\n  }\n}\n\n// Fallback: dùng msg (đã toLowerCase) thay vì chatInput gốc\nif (!keyword) {\n  keyword = msg;\n}\n\nconst originalData = $('When chat message received').first().json;\nreturn [{ json: { ...originalData, keyword } }];"
      },
